# PostgreSQL environment variables for Docker Compose.
# devcontainer.json's postCreateCommand "shell-env" step sources this and
# builds DATABASE_URL (asyncpg URL, read by FastAPI/SQLAlchemy and Alembic)
# from these vars, so there's no separate connection-string key to duplicate.
POSTGRES_PASSWORD=<generate-a-password>
POSTGRES_USER=postgres
POSTGRES_DB=<project>
