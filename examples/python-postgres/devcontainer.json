// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet-postgres
{
    "name": "Python (FastAPI) and PostgreSQL",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"features": {
		// Node.js for frontend
		"ghcr.io/devcontainers/features/node:2": {},
		// Claude Code
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
		// GitHub CLI
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Configure tool-specific properties.
	// VS code specific properties: https://containers.dev/supporting#visual-studio-code
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python"
			]
		}
	},


	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// backend, frontend, postgres
	"forwardPorts": [8000, 5173, 5432],
	// "portsAttributes": {
	//		"5001": {
	//			"protocol": "https"
	//		}
	// }

    "mounts": [
		// Keep frontend node_modules off the slow Windows bind mount (VS Code "Improve disk performance")
		"source=frontend-node-modules,target=${containerWorkspaceFolder}/frontend/node_modules,type=volume",
		// Mount a volume for Claude credentials
		"source=claude-credentials,target=/home/vscode/.claude,type=volume"
    ],

	// Use 'containerEnv' to set environment variables in the container. (for all processes, set during container build)
	"containerEnv": {
		// Increase Node.js memory limit for Claude Code
		"NODE_OPTIONS": "--max-old-space-size=4096",
		// Tell Claude Code where to find its config
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
		"TZ": "Pacific/Auckland"
	},

    // Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": {
	// Install Python dependencies; skipped until backend/pyproject.toml exists, because a failing step stops the later ones
    "backend": "cd backend && if [ -f pyproject.toml ]; then uv sync; fi",
    // Install frontend dependencies
    // New named volumes are root-owned, so hand node_modules to vscode before installing
    "frontend": "cd frontend && sudo chown vscode:vscode node_modules && npm install",
	// Set up Claude onboarding state, skip the onboarding process
	"claude-onboarding": "echo '{\"hasCompletedOnboarding\":true}' > /home/vscode/.claude/.claude.json",
	// Sources .env vars then builds DATABASE_URL (asyncpg URL read by the backend and Alembic)
	// from the POSTGRES_* vars, so .env has no duplicate connection-string key
	"shell-env": "echo 'set -a; source ${containerWorkspaceFolder}/.devcontainer/.env; set +a; export DATABASE_URL=\"postgresql+asyncpg://$POSTGRES_USER:$POSTGRES_PASSWORD@db:5432/$POSTGRES_DB\"' >> ~/.bashrc"
	},

	// Executes the firewall script every time the container starts
	// and tells git "I trust this directory": https://www.kenmuse.com/blog/avoiding-dubious-ownership-in-dev-containers/
	"postStartCommand": "sudo /usr/local/bin/project-firewall.sh && git config --global --add safe.directory ${containerWorkspaceFolder}",
	
	// Wait for the firewall to be set up
	"waitFor": "postStartCommand"


	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}


