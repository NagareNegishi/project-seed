{
  "name": "<project>-extension",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && node scripts/build.mjs",
    "build:store": "npm run typecheck && node scripts/build.mjs --store",
    "build:prod-local": "npm run typecheck && node scripts/build.mjs --prod-local",
    "build:firefox": "npm run typecheck && node scripts/build.mjs --firefox",
    "watch": "node scripts/build.mjs --watch"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "esbuild": "0.28.2",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "lucide": "^1.55.0"
  }
}
