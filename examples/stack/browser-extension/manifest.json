{
  "manifest_version": 3,
  "name": "<Project Name>",
  "version": "0.1.0",
  "description": "<One-line description of what the extension does.>",
  "key": "<unpacked-dev-key>",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:<backend-port>/*",
    "https://api.<your-domain>/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["icons/<project>-64.png", "icons/logo-<project>.svg"],
      "matches": ["<all_urls>"]
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:<frontend-port>/extension/connect*",
      "http://127.0.0.1:<frontend-port>/extension/connect*",
      "https://<your-domain>/extension/connect*"
    ]
  },
  "icons": {
    "16": "icons/<project>-16.png",
    "32": "icons/<project>-32.png",
    "128": "icons/<project>-128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/<project>-16.png",
      "32": "icons/<project>-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
