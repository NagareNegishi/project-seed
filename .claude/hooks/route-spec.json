    "assert": "each assertion is one of: {section, check:'none'} body is 'none'; {section, check:'nonempty'} body is not 'none'/empty; {section, check:'prefix', value} body begins with value (Build pass/fail); {sections:[...], check:'any_nonempty'} at least one is not 'none'. Assertions in a list are AND-ed."
  },
